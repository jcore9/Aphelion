{
  "name": "aphelion",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.5",
  "workspaces": [
    "packages/*",
    "docs"
  ],
  "scripts": {
    "lint": "bun --bun eslint . && bun --bun prettier --check .",
    "format": "bun --bun prettier --write .",
    "typecheck": "tsc --noEmit && bun run --filter '@aphelion/*' typecheck",
    "test": "bun --bun vitest run"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/bun": "1.4.5",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
