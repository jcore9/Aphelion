{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "oneOf": [
    {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "v": {
              "type": "number",
              "const": 1,
              "description": "The protocol version."
            },
            "type": {
              "type": "string",
              "const": "result",
              "description": "The frame type."
            },
            "id": {
              "description": "The id of the command this frame answers.",
              "allOf": [
                {
                  "$ref": "#/definitions/CommandId"
                }
              ]
            },
            "name": {
              "type": "string",
              "const": "ping",
              "description": "The command that ran."
            },
            "result": {
              "type": "object",
              "properties": {},
              "additionalProperties": false,
              "description": "The command's output."
            }
          },
          "required": [
            "v",
            "type",
            "id",
            "name",
            "result"
          ],
          "additionalProperties": false,
          "description": "Answers a command that succeeded."
        },
        {
          "type": "object",
          "properties": {
            "v": {
              "type": "number",
              "const": 1,
              "description": "The protocol version."
            },
            "type": {
              "type": "string",
              "const": "result",
              "description": "The frame type."
            },
            "id": {
              "description": "The id of the command this frame answers.",
              "allOf": [
                {
                  "$ref": "#/definitions/CommandId"
                }
              ]
            },
            "name": {
              "type": "string",
              "const": "bot.prompt",
              "description": "The command that ran."
            },
            "result": {
              "type": "object",
              "properties": {
                "turn": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,64}$",
                  "description": "The turn the bot started. A repeat of the command returns the same turn."
                }
              },
              "required": [
                "turn"
              ],
              "additionalProperties": false,
              "description": "The command's output."
            }
          },
          "required": [
            "v",
            "type",
            "id",
            "name",
            "result"
          ],
          "additionalProperties": false,
          "description": "Answers a command that succeeded."
        },
        {
          "type": "object",
          "properties": {
            "v": {
              "type": "number",
              "const": 1,
              "description": "The protocol version."
            },
            "type": {
              "type": "string",
              "const": "result",
              "description": "The frame type."
            },
            "id": {
              "description": "The id of the command this frame answers.",
              "allOf": [
                {
                  "$ref": "#/definitions/CommandId"
                }
              ]
            },
            "name": {
              "type": "string",
              "const": "bot.cancel",
              "description": "The command that ran."
            },
            "result": {
              "type": "object",
              "properties": {},
              "additionalProperties": false,
              "description": "The command's output."
            }
          },
          "required": [
            "v",
            "type",
            "id",
            "name",
            "result"
          ],
          "additionalProperties": false,
          "description": "Answers a command that succeeded."
        },
        {
          "type": "object",
          "properties": {
            "v": {
              "type": "number",
              "const": 1,
              "description": "The protocol version."
            },
            "type": {
              "type": "string",
              "const": "result",
              "description": "The frame type."
            },
            "id": {
              "description": "The id of the command this frame answers.",
              "allOf": [
                {
                  "$ref": "#/definitions/CommandId"
                }
              ]
            },
            "name": {
              "type": "string",
              "const": "history.read",
              "description": "The command that ran."
            },
            "result": {
              "type": "object",
              "properties": {
                "events": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "seq": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991,
                        "description": "The event's position, as in an event frame."
                      },
                      "payload": {
                        "type": "object",
                        "properties": {
                          "bot": {
                            "type": "string",
                            "pattern": "^[a-z][a-z0-9-]{0,62}$",
                            "description": "The bot the event belongs to."
                          },
                          "turn": {
                            "anyOf": [
                              {
                                "type": "string",
                                "pattern": "^[A-Za-z0-9_-]{1,64}$",
                                "description": "The id of one turn, the bot's work on one prompt."
                              },
                              {
                                "type": "null"
                              }
                            ],
                            "description": "The turn the event belongs to. It is `null` for an `error` outside a turn."
                          },
                          "format": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 9007199254740991,
                            "description": "The format version of the saved event. It is 1 today, and a change to an event's shape raises it."
                          },
                          "event": {
                            "description": "What happened.",
                            "allOf": [
                              {
                                "$ref": "#/definitions/BotEvent"
                              }
                            ]
                          }
                        },
                        "required": [
                          "bot",
                          "turn",
                          "format",
                          "event"
                        ],
                        "additionalProperties": false,
                        "description": "The same payload an event frame carries."
                      }
                    },
                    "required": [
                      "seq",
                      "payload"
                    ],
                    "additionalProperties": false
                  },
                  "description": "The events the client may see, in order. A page can hold fewer than `limit`, or none, while `more` is `true`."
                },
                "next": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "description": "The position to send as `after` to read the next page. It can be higher than the last event, because the server skips events a client never sees."
                },
                "more": {
                  "type": "boolean",
                  "description": "Whether the server holds more saved events of this bot after `next`."
                }
              },
              "required": [
                "events",
                "next",
                "more"
              ],
              "additionalProperties": false,
              "description": "The command's output."
            }
          },
          "required": [
            "v",
            "type",
            "id",
            "name",
            "result"
          ],
          "additionalProperties": false,
          "description": "Answers a command that succeeded."
        }
      ]
    },
    {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "v": {
              "type": "number",
              "const": 1,
              "description": "The protocol version."
            },
            "type": {
              "type": "string",
              "const": "event",
              "description": "The frame type."
            },
            "seq": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "description": "The event's position in the stream."
            },
            "name": {
              "type": "string",
              "const": "notice",
              "description": "The kind of event."
            },
            "payload": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string",
                  "description": "Text for a person to read."
                }
              },
              "required": [
                "message"
              ],
              "additionalProperties": false,
              "description": "What happened."
            }
          },
          "required": [
            "v",
            "type",
            "seq",
            "name",
            "payload"
          ],
          "additionalProperties": false,
          "description": "Tells every client that something happened."
        },
        {
          "type": "object",
          "properties": {
            "v": {
              "type": "number",
              "const": 1,
              "description": "The protocol version."
            },
            "type": {
              "type": "string",
              "const": "event",
              "description": "The frame type."
            },
            "seq": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "description": "The event's position in the stream."
            },
            "name": {
              "type": "string",
              "const": "bot.event",
              "description": "The kind of event."
            },
            "payload": {
              "type": "object",
              "properties": {
                "bot": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,62}$",
                  "description": "The bot the event belongs to."
                },
                "turn": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]{1,64}$",
                      "description": "The id of one turn, the bot's work on one prompt."
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "The turn the event belongs to. It is `null` for an `error` outside a turn."
                },
                "format": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991,
                  "description": "The format version of the saved event. It is 1 today, and a change to an event's shape raises it."
                },
                "event": {
                  "description": "What happened.",
                  "allOf": [
                    {
                      "$ref": "#/definitions/BotEvent"
                    }
                  ]
                }
              },
              "required": [
                "bot",
                "turn",
                "format",
                "event"
              ],
              "additionalProperties": false,
              "description": "What happened."
            }
          },
          "required": [
            "v",
            "type",
            "seq",
            "name",
            "payload"
          ],
          "additionalProperties": false,
          "description": "Tells every client that something happened."
        }
      ]
    },
    {
      "type": "object",
      "properties": {
        "v": {
          "type": "number",
          "const": 1,
          "description": "The protocol version."
        },
        "type": {
          "type": "string",
          "const": "resync",
          "description": "The frame type."
        },
        "cursor": {
          "description": "Where the client continues after it reloads.",
          "allOf": [
            {
              "$ref": "#/definitions/Cursor"
            }
          ]
        }
      },
      "required": [
        "v",
        "type",
        "cursor"
      ],
      "additionalProperties": false,
      "description": "Tells a client that it can't catch up."
    },
    {
      "type": "object",
      "properties": {
        "v": {
          "type": "number",
          "const": 1,
          "description": "The protocol version."
        },
        "type": {
          "type": "string",
          "const": "error",
          "description": "The frame type."
        },
        "code": {
          "type": "string",
          "enum": [
            "malformed",
            "unsupported-version",
            "bot-not-running",
            "bot-busy",
            "prompt-too-long",
            "prompt-refused",
            "interrupted",
            "id-reused",
            "internal"
          ],
          "description": "Why the frame was rejected."
        },
        "message": {
          "type": "string",
          "description": "Fixed text that is safe to log."
        },
        "id": {
          "description": "The rejected command's id, when it had a valid one.",
          "allOf": [
            {
              "$ref": "#/definitions/CommandId"
            }
          ]
        }
      },
      "required": [
        "v",
        "type",
        "code",
        "message"
      ],
      "additionalProperties": false,
      "description": "Rejects a frame."
    }
  ],
  "title": "ServerFrame",
  "definitions": {
    "CommandId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$",
      "description": "Names one command. The client picks it, and a retry sends the same id."
    },
    "BotTextDelta": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "text.delta",
          "description": "The kind of event."
        },
        "text": {
          "type": "string",
          "description": "The next piece of the bot's reply. It is 1 byte to 16 KiB of UTF-8."
        }
      },
      "required": [
        "type",
        "text"
      ],
      "additionalProperties": false,
      "description": "A piece of the bot's reply."
    },
    "BotToolStart": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "tool.start",
          "description": "The kind of event."
        },
        "call": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
          "description": "The id of the tool call, for the matching `tool.end`."
        },
        "tool": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
          "description": "The tool's name."
        },
        "kind": {
          "type": "string",
          "enum": [
            "file.read",
            "file.write",
            "shell",
            "web",
            "other"
          ],
          "description": "What the tool does, in terms that don't depend on the vendor."
        }
      },
      "required": [
        "type",
        "call",
        "tool",
        "kind"
      ],
      "additionalProperties": false,
      "description": "The bot started to use a tool."
    },
    "BotToolEnd": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "tool.end",
          "description": "The kind of event."
        },
        "call": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
          "description": "The id of the tool call that ended."
        },
        "outcome": {
          "type": "string",
          "enum": [
            "ok",
            "error",
            "denied",
            "cancelled"
          ],
          "description": "How the call ended."
        }
      },
      "required": [
        "type",
        "call",
        "outcome"
      ],
      "additionalProperties": false,
      "description": "A tool call ended."
    },
    "BotUsage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "usage",
          "description": "The kind of event."
        },
        "inputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Tokens the bot read."
        },
        "outputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Tokens the bot wrote."
        },
        "cacheReadTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Tokens read from the vendor's cache."
        },
        "cacheWriteTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Tokens written to the vendor's cache."
        },
        "costUsd": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ],
          "description": "The cost in US dollars, or `null` when the vendor has none."
        }
      },
      "required": [
        "type",
        "inputTokens",
        "outputTokens",
        "cacheReadTokens",
        "cacheWriteTokens",
        "costUsd"
      ],
      "additionalProperties": false,
      "description": "What a turn used."
    },
    "BotError": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "error",
          "description": "The kind of event."
        },
        "code": {
          "type": "string",
          "enum": [
            "cli-not-found",
            "cli-exited",
            "signed-out",
            "rate-limited",
            "vendor",
            "adapter"
          ],
          "description": "What went wrong, as a fixed code."
        }
      },
      "required": [
        "type",
        "code"
      ],
      "additionalProperties": false,
      "description": "Something went wrong with the bot."
    },
    "BotTurnEnd": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "turn.end",
          "description": "The kind of event."
        },
        "reason": {
          "type": "string",
          "enum": [
            "completed",
            "cancelled",
            "denied",
            "limit",
            "refused",
            "error"
          ],
          "description": "Why the turn ended."
        }
      },
      "required": [
        "type",
        "reason"
      ],
      "additionalProperties": false,
      "description": "A turn ended."
    },
    "BotPermissionRequest": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "permission.request",
          "description": "The kind of event."
        },
        "request": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
          "description": "The id of the request, for the matching decision."
        },
        "call": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
            },
            {
              "type": "null"
            }
          ],
          "description": "The tool call the request is for, or `null`."
        },
        "tool": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
          "description": "The tool's name."
        },
        "kind": {
          "type": "string",
          "enum": [
            "file.read",
            "file.write",
            "shell",
            "web",
            "other"
          ],
          "description": "What the tool does, in terms that don't depend on the vendor."
        },
        "pathCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32,
          "description": "How many paths the tool wants. The paths are never sent."
        },
        "hasCommand": {
          "type": "boolean",
          "description": "Whether the tool wants to run a command. It is never sent."
        }
      },
      "required": [
        "type",
        "request",
        "call",
        "tool",
        "kind",
        "pathCount",
        "hasCommand"
      ],
      "additionalProperties": false,
      "description": "The bot asked whether a tool may run."
    },
    "BotPermissionDecision": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "permission.decision",
          "description": "The kind of event."
        },
        "request": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
          "description": "The id of the request this decision answers."
        },
        "decision": {
          "type": "string",
          "enum": [
            "allow",
            "deny"
          ],
          "description": "The answer."
        },
        "by": {
          "type": "string",
          "enum": [
            "rule",
            "policy",
            "owner",
            "default"
          ],
          "description": "Who decided."
        },
        "reason": {
          "type": "string",
          "enum": [
            "inside-folder",
            "outside-folder",
            "web",
            "shell",
            "unknown-tool",
            "cancelled",
            "turn-ended",
            "timeout",
            "shutdown",
            "no-decider",
            "invalid-request",
            "duplicate-request",
            "invalid-decision",
            "decider-failed"
          ],
          "description": "Why, as a fixed code."
        }
      },
      "required": [
        "type",
        "request",
        "decision",
        "by",
        "reason"
      ],
      "additionalProperties": false,
      "description": "A permission request was allowed or denied."
    },
    "BotEvent": {
      "oneOf": [
        {
          "$ref": "#/definitions/BotTextDelta"
        },
        {
          "$ref": "#/definitions/BotToolStart"
        },
        {
          "$ref": "#/definitions/BotToolEnd"
        },
        {
          "$ref": "#/definitions/BotUsage"
        },
        {
          "$ref": "#/definitions/BotError"
        },
        {
          "$ref": "#/definitions/BotTurnEnd"
        },
        {
          "$ref": "#/definitions/BotPermissionRequest"
        },
        {
          "$ref": "#/definitions/BotPermissionDecision"
        }
      ],
      "description": "One thing a bot did. The bot's session is not one of them: the server keeps it."
    },
    "StreamId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$",
      "description": "Names one event stream. It is not the server ID: the server gives the stream a new ID when it restores a backup, so a cursor from before the restore gets `resync`."
    },
    "Cursor": {
      "type": "object",
      "properties": {
        "stream": {
          "description": "The stream that the position is in.",
          "allOf": [
            {
              "$ref": "#/definitions/StreamId"
            }
          ]
        },
        "seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "The position of the last event the client has seen."
        }
      },
      "required": [
        "stream",
        "seq"
      ],
      "additionalProperties": false,
      "description": "A position in an event stream."
    }
  }
}
