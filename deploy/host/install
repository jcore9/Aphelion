#!/bin/bash
set -euo pipefail

readonly root=/opt/aphelion
readonly unit=/etc/systemd/system/aphelion.service
readonly credential=/etc/credstore.encrypted/aphelion-bootstrap

if ((EUID != 0)); then
  echo "install: run this with sudo" >&2
  exit 1
fi
if [[ $(cd "$(dirname "$0")/../.." && pwd -P) != "$root" ]]; then
  echo "install: clone Aphelion to $root first. The unit runs the files there." >&2
  exit 1
fi
for path in "$root" "$root/deploy" "$root/deploy/host"; do
  if [[ $(stat -c '%u' "$path") != 0 ]] || (($(stat -c '%a' "$path" | sed 's/^/8#/') & 8#022)); then
    echo "install: $path must be owned by root and writable only by root" >&2
    exit 1
  fi
done
if [[ ! -f $root/deploy/.env ]]; then
  echo "install: create $root/deploy/.env with APHELION_TAILNET_ADDRESS first" >&2
  exit 1
fi

holds_key() {
  systemd-creds decrypt --name=bootstrap "$1" - 2>/dev/null | grep -Ex 'AGE-SECRET-KEY-1[0-9A-Z]{58}' >/dev/null
}

if [[ -e $credential ]]; then
  if ! holds_key "$credential"; then
    echo "install: $credential holds no bootstrap key. install never replaces it, so check it by hand." >&2
    exit 1
  fi
  echo "install: keeping the bootstrap key in $credential"
else
  install -d -o root -g root -m 0700 "$(dirname "$credential")"
  temporary=$credential.$$.tmp
  trap 'rm -f "$temporary"' EXIT
  (
    umask 077
    docker run --rm --pull never --log-driver none --network none --read-only --user aphelion-secrets \
      --entrypoint /usr/local/bin/aphelion-secrets aphelion:local --new-key |
      systemd-creds encrypt --name=bootstrap - "$temporary"
  )
  holds_key "$temporary" || { echo "install: the new bootstrap key didn't decrypt, so install stops" >&2; exit 1; }
  ln "$temporary" "$credential"
  rm -f "$temporary"
  echo "install: created the bootstrap key in $credential. Keep a recovery copy. Print it with:"
  echo "  sudo systemd-creds decrypt --name=bootstrap $credential -"
fi
install -o root -g root -m 0644 "$root/deploy/host/aphelion.service" "$unit"
systemctl daemon-reload
systemctl enable aphelion.service
echo "install: aphelion.service is installed and enabled. Start it with: sudo systemctl start aphelion"
